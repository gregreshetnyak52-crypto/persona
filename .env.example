# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Режим работы: true — тестовый без YClients API, false — боевой
YCLIENTS_MOCK=true

# YClients API — получить на https://developers.yclients.com/
YCLIENTS_PARTNER_TOKEN=your_partner_token_here
YCLIENTS_USER_TOKEN=your_user_token_here
YCLIENTS_COMPANY_ID=123456

# Telegram ID администраторов (через запятую, без пробелов)
# Узнать свой ID: написать @userinfobot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Пароль для входа в /admin панель
ADMIN_PASSWORD=secret123

# Прокси для серверов с ограниченным доступом к Telegram API (например, российский хостинг)
# Формат: socks5://user:password@host:port
# Оставьте пустым если прокси не нужен
PROXY_URL=

# Telegram Mini App — сайт салона, открывается кнопкой «Наш сайт» в главном меню
WEBAPP_URL=https://persona-krasnogorsk.ru/
