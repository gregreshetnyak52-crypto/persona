# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Режим работы: true — тестовый без YClients API, false — боевой
YCLIENTS_MOCK=true

# YClients API — получить на https://developers.yclients.com/
YCLIENTS_PARTNER_TOKEN=your_partner_token_here
YCLIENTS_USER_TOKEN=your_user_token_here
YCLIENTS_COMPANY_ID=123456

# Telegram ID администраторов (через запятую, без пробелов)
# Узнать свой ID: написать @userinfobot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Пароль для входа в /admin панель
ADMIN_PASSWORD=secret123

# Прокси для серверов с ограниченным доступом к Telegram API (например, российский хостинг)
# Формат: socks5://user:password@host:port
# Оставьте пустым если прокси не нужен
PROXY_URL=

# Ссылка на сайт салона — кнопка «Наш сайт» в главном меню (просто внешняя ссылка)
WEBAPP_URL=https://persona-krasnogorsk.ru/

# Порт встроенного веб-сервера (Mini App + JSON API). На Railway передаётся
# автоматически через PORT — руками задавать не нужно.
PORT=8080

# Telegram Mini App записи — HTTPS-адрес ЭТОГО ЖЕ сервиса (Railway домен).
# Пока пусто — кнопка Mini App не показывается, работает обычный текстовый флоу.
# Узнать домен можно в Railway после первого деплоя (Settings → Networking).
MINI_APP_URL=

# Отключает проверку подписи Telegram initData — ТОЛЬКО для локальной разработки.
# Никогда не включайте в проде.
WEBAPP_DEV_MODE=false
